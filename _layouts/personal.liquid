<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% if page.permalink == '/' -%}
        {{- site.title | escape }} | Cancer Biology
      {%- else -%}
        {{- page.title | escape }} | {{ site.title | escape -}}
      {%- endif %}
    </title>
    <meta name="description" content="{{ page.description | escape }}">
    <meta name="theme-color" content="#faf9f7">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E⚛%3C/text%3E%3C/svg%3E"
    >
    <link rel="stylesheet" href="{{ '/assets/css/publications.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/personal.css' | relative_url }}">
    <script src="{{ '/assets/js/publications.js' | relative_url }}" defer></script>
  </head>
  <body id="top" class="page-{% if page.layout == 'personal-post' %}blog{% else %}{{ page.section | default: 'publication' }}{% endif %}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href="{{ '/' | relative_url }}"
          ><strong>{{ site.title | escape }}</strong><span>Yale School of Medicine</span></a
        >
        <nav class="site-nav" aria-label="Main navigation">
          <a
            href="{{ '/' | relative_url }}"
            {% if page.section == 'home' %}
              aria-current="page"
            {% endif %}
            >Home</a
          >
          <a
            href="{{ '/research/' | relative_url }}"
            {% if page.section == 'research' %}
              aria-current="page"
            {% endif %}
            >Research</a
          >
          <a
            href="{{ '/publications/' | relative_url }}"
            {% if page.section == 'publication' %}
              aria-current="page"
            {% endif %}
            >Publication</a
          >
          <a
            href="{{ '/blog/' | relative_url }}"
            {% if page.section == 'blog' or page.layout == 'personal-post' %}
              aria-current="page"
            {% endif %}
            >Blog</a
          >
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.7 13.3A9 9 0 0 1 10.7 3.3a9 9 0 1 0 10 10Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main-content" class="wrap" tabindex="-1">{{ content }}</main>
    <footer class="site-footer wrap">
      <div>
        <strong>{{ site.title | escape }}</strong>
        <p>Cancer biology · Cancer evolution</p>
        <div class="footer-links">
          <a href="{{ '/assets/pdf/cv2.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer">CV ↗</a
          ><a href="https://scholar.google.com/citations?user=y-T-GUMAAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a
          ><a href="https://orcid.org/0000-0002-1554-1569" target="_blank" rel="noopener noreferrer">ORCID ↗</a>
        </div>
      </div>
      <div>
        <a href="mailto:xiaoling.li@yale.edu">xiaoling.li@yale.edu</a>
        <p>New Haven, Connecticut</p>
      </div>
    </footer>
  </body>
</html>
