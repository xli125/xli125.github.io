---
---
<article class="publication-entry" id="paper-{{ entry.key }}" data-year="{{ entry.year }}">
  <div class="entry-main">
    <p class="entry-journal">
      {{ entry.journal -}}
      {%- if entry.volume -%}
        <span>
          · {{ entry.volume -}}
          {%- if entry.number %}({{ entry.number }}){% endif -%}
          {%- if entry.pages %}, {{ entry.pages | replace: '--', '–' }}{% endif -%}
        </span>
      {%- endif %}
    </p>
    <h3>
      <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>
    </h3>
    <details class="entry-authors">
      <summary>
        <span class="author-preview">
          {%- for author in entry.author_array limit: 3 -%}
            {{- author.first }}
            {{ author.last -}}
            {%- unless forloop.last %}, {% endunless -%}
          {%- endfor -%}
          {%- if entry.author_array.size > 3 %}, et al.{% endif -%}</span
        ><span class="authors-toggle">Authors <span aria-hidden="true">+</span></span>
      </summary>
      <p>
        {% for author in entry.author_array -%}
          {{- author.first }}
          {{ author.last -}}
          {%- unless forloop.last %}, {% endunless -%}
        {%- endfor %}
      </p>
    </details>
  </div>
  <div class="entry-links" aria-label="Links for {{ entry.title | escape }}">
    <a
      class="paper-link"
      href="https://doi.org/{{ entry.doi }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Article: {{ entry.title | escape }}"
      >Article <span aria-hidden="true">↗</span></a
    >
    {% if entry.pdf -%}
      <a
        href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="PDF: {{ entry.title | escape }}"
        >PDF</a
      >
    {%- endif %}
    {% if entry.pmid -%}
      <a
        href="https://pubmed.ncbi.nlm.nih.gov/{{ entry.pmid }}/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="PubMed: {{ entry.title | escape }}"
        >PubMed</a
      >
    {%- endif %}
  </div>
</article>
